---
import { marked } from "marked";
import Base from "../../layouts/Base.astro";
import { getTasks, getRuns, summarize, type Task, REPO_URL, fmtDate } from "../../lib/data";

export function getStaticPaths() {
  return getTasks().map((task) => ({ params: { slug: task.slug }, props: { task } }));
}
const { task } = Astro.props as { task: Task };
const base = import.meta.env.BASE_URL;
const html = marked.parse(task.prompt) as string;
const grading = {
  sql: "The answer is a DuckDB SQL script. It runs against a hidden fixture, then checks query the resulting tables.",
  structured: "The answer is a JSON object, compared field by field with an answer key.",
  rubric: "The answer is free text, scored by an LLM judge against a rubric, with a reference answer as guidance.",
}[task.answer_type];
const history = getRuns()
  .filter((r) => r.benchmark.task_ids.includes(task.id))
  .map((r) => ({ run: r, rows: summarize(r).map((s) => ({ label: s.variant.label, score: (s.taskScores.get(task.id) ?? 0) * 100 })).sort((a, b) => b.score - a.score) }));
---
<Base title={task.title} description={`dataeng-bench task: ${task.title}`}>
  <p style="margin-top:24px"><a href={`${base}tasks/`}>← All tasks</a></p>
  <h1>{task.title}</h1>
  <div class="badges">
    <span class="badge">{task.category.replace("_", " ")}</span>
    <span class="badge">{task.subcategory}</span>
    <span class="badge">{task.difficulty}</span>
    <span class="badge">{task.answer_type === "sql" ? "SQL" : task.answer_type}</span>
    {task.tags.map((t) => <span class="badge" style="font-weight:400">#{t}</span>)}
  </div>

  <div class="two-col" style="margin-top:24px">
    <div>
      <h2 style="margin-top:0">Prompt shown to the model</h2>
      <div class="card prompt" set:html={html} />
    </div>
    <aside>
      <h2 style="margin-top:0">How it is graded</h2>
      <p>{grading}</p>
      <p><a href={`${REPO_URL}/tree/main/${task.relPath}`}>Fixtures, checks and reference answer on GitHub →</a></p>

      <h2>Results</h2>
      {history.length === 0 && <p class="muted">Not in any run yet.</p>}
      {history.map(({ run, rows }) => (
        <div style="margin-bottom:18px">
          <div style="font-size:13px"><a href={`${base}runs/${run.id}/`}>{run.title}</a> <span class="muted">· {fmtDate(run.created_at)}</span>
            {run.sample && <span class="badge sample" style="margin-left:4px">Sample</span>}</div>
          <table style="font-size:13px">
            <tbody>
              {rows.map((r) => (
                <tr>
                  <td style="padding:4px 8px 4px 0;border:0">{r.label}</td>
                  <td style="padding:4px 0;border:0;width:90px"><div class="mini-track"><div class="mini-bar" style={`width:${r.score}%`}></div></div></td>
                  <td class="r" style="padding:4px 0 4px 8px;border:0">{r.score.toFixed(0)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))}

      <h2>Sources</h2>
      <ul class="sources">
        {task.sources.map((s) => (
          <li>{s.url ? <a href={s.url}>{s.title}</a> : s.title}{s.note && <div class="muted" style="font-size:13px">{s.note}</div>}</li>
        ))}
      </ul>
      <p class="muted" style="font-size:12px"><code>{task.id}</code></p>
    </aside>
  </div>
</Base>
