---
import { REPO_URL, getRuns } from "../lib/data";
interface Props { title: string; description?: string }
const { title, description = "An open benchmark for LLMs on data and analytics engineering work." } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const nav = [
  { href: base, label: "Leaderboard", active: path === base },
  { href: `${base}runs/`, label: "Runs", active: path.startsWith(`${base}runs`) },
  { href: `${base}tasks/`, label: "Tasks", active: path.startsWith(`${base}tasks`) },
];
const hasSample = getRuns().some((r) => r.sample);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title === "dataeng-bench" ? title : `${title} · dataeng-bench`}</title>
  <meta name="description" content={description} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
  <link rel="stylesheet" href={`${base}styles.css`} />
</head>
<body>
  {hasSample && (
    <div class="sample-banner" role="note">
      <strong>Sample data.</strong> The runs on this site are made up, for fictional models, until the harness produces real results.
    </div>
  )}
  <header class="site-header">
    <div class="wrap header-inner">
      <a class="brand" href={base}>
        <svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3" fill="none" stroke="currentColor" stroke-width="2"/><path d="M4 5v14c0 1.7 3.6 3 8 3s8-1.3 8-3V5" fill="none" stroke="currentColor" stroke-width="2"/><path d="M4 12c0 1.7 3.6 3 8 3s8-1.3 8-3" fill="none" stroke="currentColor" stroke-width="2"/></svg>
        dataeng-bench
      </a>
      <nav>
        {nav.map((n) => <a href={n.href} aria-current={n.active ? "page" : undefined}>{n.label}</a>)}
        <a href={REPO_URL} class="gh">GitHub</a>
      </nav>
    </div>
  </header>
  <main class="wrap"><slot /></main>
  <footer class="wrap site-footer">
    dataeng-bench is open source under Apache-2.0. <a href={REPO_URL}>Source, tasks and raw results on GitHub</a>.
  </footer>
  <div id="tip" role="tooltip" hidden></div>
  <script is:inline>
    // One floating tooltip for every element with data-tip (bars, heatmap cells).
    const tip = document.getElementById("tip");
    const show = (e) => {
      const el = e.target.closest("[data-tip]");
      if (!el) { tip.hidden = true; return; }
      tip.innerHTML = el.dataset.tip;
      tip.hidden = false;
      const r = tip.getBoundingClientRect();
      let x = e.clientX + 14, y = e.clientY + 14;
      if (x + r.width > innerWidth - 8) x = e.clientX - r.width - 14;
      if (y + r.height > innerHeight - 8) y = e.clientY - r.height - 14;
      tip.style.left = x + "px"; tip.style.top = y + "px";
    };
    document.addEventListener("pointermove", show);
    document.addEventListener("pointerleave", () => (tip.hidden = true));
  </script>
</body>
</html>
